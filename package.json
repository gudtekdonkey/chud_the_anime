{
  "name": "chud-the-anime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A top-down pixel-art action game about a dark ronin.",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview --open",
    "check": "vite build && node scripts/check.mjs",
    "check:hd": "vite build && CHECK_HD=1 node scripts/check.mjs",
    "check:iso": "vite build && node scripts/check-iso.mjs",
    "check:gear": "node scripts/check-gear.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
